@using System.Security.Claims

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;

    var isAdmin = User.IsInRole("Admin");

    var isTecnico = User.IsInRole("Tecnico");

    string Active(string controller, string action = "")
    {
        var controllerOk =
            currentController.Equals(
                controller,
                StringComparison.OrdinalIgnoreCase
            );

        var actionOk =
            string.IsNullOrEmpty(action) ||
            currentAction.Equals(
                action,
                StringComparison.OrdinalIgnoreCase
            );

        return controllerOk && actionOk
            ? "active"
            : "";
    }
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - MonitoreoWeb
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <!------------ INICIO DE LA PARTE DEL LOGEO DEL ADMINISTRADOR  -------->
    @if (isAuthenticated && isAdmin)
    {
        <div class="admin-layout">

            <!--------- SIDEBAR ADMINISTRADOR ----------->
            <aside class="admin-sidebar">

                <div class="admin-sidebar-title">
                    Monitoreo Web
                </div>

                <nav class="admin-menu">

                    <a class="admin-menu-link @Active("Dashboard", "Index")"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        Dashboards
                    </a>

                    <a class="admin-menu-link @Active("Admin", "Tecnicos")"
                       asp-controller="Admin"
                       asp-action="Tecnicos">
                        Técnicos registrados
                    </a>

                    <a class="admin-menu-link @Active("Admin", "Administradores")"
                       asp-controller="Admin"
                       asp-action="Administradores">
                        Administradores dados de alta
                    </a>

                    <a class="admin-menu-link @Active("Auth", "Registrar")"
                       asp-controller="Auth"
                       asp-action="Registrar">
                        Registrar nuevos usuarios
                    </a>

                    <a class="admin-menu-link @Active("Clientes", "Registrar")"
                       asp-controller="Clientes"
                       asp-action="Registrar">
                        Registrar clientes
                    </a>

                    <a class="admin-menu-link @Active("Clientes", "Index")"
                       asp-controller="Clientes"
                       asp-action="Index">
                        Clientes registrados
                    </a>

                    <!-- NUEVO -->

                    <a class="admin-menu-link @Active("Dispositivo", "Create")"
                       asp-controller="Dispositivo"
                       asp-action="Create">
                        Registrar dispositivo
                    </a>

                    <a class="admin-menu-link @Active("Dispositivo", "Index")"
                       asp-controller="Dispositivo"
                       asp-action="Index">
                        Dispositivos registrados
                    </a>

                    <!-- FIN NUEVO -->

                    <a class="admin-menu-link @Active("Reparacion", "Index")"
                       asp-controller="Reparacion"
                       asp-action="Index">
                        Solicitudes de reparación
                    </a>

                    <a class="admin-menu-link @Active("Admin", "Reparaciones")"
                       asp-controller="Admin"
                       asp-action="Reparaciones">
                        Ver reparaciones
                    </a>

                    <!-- APARTADO PARA EL  ---- NUEVO SERVICIO ---- -->

                    <a class="admin-new-service"
                       asp-controller="Servicio"
                       asp-action="Create">
                        <span class="admin-new-service-icon">+</span>
                        <span>Nuevo servicio</span>
                    </a>

                </nav>

                <!-- FOOTER ADMIN -->
                <div class="admin-sidebar-footer">

                    <div class="admin-user-name">
                        @User.Identity?.Name
                    </div>

                    <div class="admin-user-role">
                        Rol:
                        @User.FindFirst(ClaimTypes.Role)?.Value
                    </div>

                    <a class="admin-logout"
                       asp-controller="Auth"
                       asp-action="Logout">
                        Cerrar sesión
                    </a>

                </div>

            </aside>

            <!-- CONTENIDO ADMIN -->
            <main class="admin-main">

                <div class="admin-content">
                    @RenderBody()
                </div>

            </main>

        </div>
    }

    else if (isAuthenticated && isTecnico)
    {
        <div class="admin-layout">

            <!----------------- SIDEBAR TECNICO -------------------->
            <aside class="admin-sidebar">

                <div class="admin-sidebar-title">
                    Panel Técnico
                </div>

                <nav class="admin-menu">

                    <a class="admin-menu-link"
                       asp-controller="Tecnico"
                       asp-action="Index">
                        Menú inicial
                    </a>

                    <a class="admin-menu-link"
                       asp-controller="Admin"
                       asp-action="DispositivosReparacion">
                        Equipos asignados
                    </a>

                    <a class="admin-menu-link"
                       asp-controller="Admin"
                       asp-action="">
                        Consultar dispositivos
                    </a>

                    <a class="admin-menu-link"
                       asp-controller="Admin"
                       asp-action="DispositivosReparacion">
                        Equipos asignados
                    </a>

                    <a class="admin-menu-link"
                       asp-controller="Tecnico"
                       asp-action="Solicitudes">
                        Solicitudes disponibles
                    </a>

                </nav>

                <!-- FOOTER TECNICO -->
                <div class="admin-sidebar-footer">

                    <div class="admin-user-name">
                        @User.Identity?.Name
                    </div>

                    <div class="admin-user-role">
                        Rol: Técnico
                    </div>

                    <a class="admin-logout"
                       asp-controller="Auth"
                       asp-action="Logout">
                        Cerrar sesión
                    </a>

                </div>

            </aside>

            <!-- CONTENIDO TECNICO -->
            <main class="admin-main">

                <div class="admin-content">
                    @RenderBody()
                </div>

            </main>

        </div>
    }

    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>