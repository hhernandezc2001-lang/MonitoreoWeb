@model MonitoreoWeb.Models.Reparacion

@{
    Layout = null;
    decimal costoFinal = Model.CostoFinal ?? Model.CostoEstimado ?? 0;
    decimal totalPagado = Model.Pagos?.Sum(p => p.Monto) ?? 0;
    DateTime fechaEntrega = Model.FechaEntregaCliente ?? DateTime.Now;
    DateTime fechaFinGarantia = fechaEntrega.AddDays(Model.DiasGarantia);

    string nombreAdmin = User.Identity?.Name ?? "Administrador";

    // Obtenemos el nombre del técnico de forma segura (sin invocar la propiedad Apellido que no existe)
    string nombreTecnico = Model.Tecnico != null ? Model.Tecnico.Nombre : "Personal de Taller";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Comprobante de Entrega - #@Model.IdReparacion</title>
    <style>
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            width: 80mm;
            margin: 0 auto;
            padding: 5px;
            color: #000;
        }

        .text-center {
            text-align: center;
        }

        .fw-bold {
            font-weight: bold;
        }

        .border-bottom {
            border-bottom: 1px dashed #000;
            padding-bottom: 5px;
            margin-bottom: 5px;
        }

        .row {
            display: flex;
            justify-content: space-between;
        }

        .admin-signature {
            max-width: 100%;
            max-height: 65px;
            margin-top: 5px;
        }

        .signature-box {
            border-bottom: 1px solid #000;
            height: 40px;
            margin-top: 25px;
            margin-bottom: 5px;
        }
    </style>
</head>
<body onload="window.print()">

    <div class="text-center border-bottom">
        <h2 style="margin: 0;">SIGER</h2>
        <p style="margin: 2px 0;">COMPROBANTE DE ENTREGA Y GARANTÍA</p>
        <p style="margin: 2px 0;">Orden: #@Model.IdReparacion</p>
        <p style="margin: 2px 0;">Entregado: @fechaEntrega.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <div class="border-bottom">
        <p class="fw-bold" style="margin: 5px 0;">CLIENTE Y DISPOSITIVO</p>
        <p style="margin: 2px 0;">Cliente: @Model.Dispositivo?.Cliente?.Nombre @Model.Dispositivo?.Cliente?.Apellido</p>
        <p style="margin: 2px 0;">Equipo: @Model.Dispositivo?.Marca @Model.Dispositivo?.Modelo</p>
        <p style="margin: 2px 0;">Técnico Asignado: @nombreTecnico</p>
    </div>

    <div class="border-bottom">
        <p class="fw-bold" style="margin: 5px 0;">RESUMEN FINANCIERO</p>
        <div class="row"><span>Costo Reparación:</span><span>$@costoFinal.ToString("N2")</span></div>
        @if (Model.Pagos != null)
        {
            int numPago = 1;
            foreach (var pago in Model.Pagos.OrderBy(p => p.FechaPago))
            {
                <div class="row" style="font-size: 11px;"><span>Abono @numPago (@pago.FechaPago.ToString("dd/MM/yy")):</span><span>$@pago.Monto.ToString("N2")</span></div>
                numPago++;
            }
        }
        <div class="row fw-bold" style="font-size: 14px; margin-top: 5px;"><span>TOTAL PAGADO:</span><span>$@totalPagado.ToString("N2")</span></div>
        <div class="row fw-bold"><span>SALDO PENDIENTE:</span><span>$0.00</span></div>
    </div>

    <div class="border-bottom text-center">
        <p class="fw-bold" style="margin: 5px 0;">PÓLIZA DE GARANTÍA (@Model.DiasGarantia DÍAS)</p>
        <p style="margin: 2px 0; font-size: 11px;">Válida del <strong>@fechaEntrega.ToString("dd/MM/yyyy")</strong> al <strong>@fechaFinGarantia.ToString("dd/MM/yyyy")</strong>.</p>
        <p style="font-size: 9px; text-align: justify; margin-top: 5px;">El equipo ha sido probado a satisfacción del cliente. No aplica garantía por daños físicos, golpes o humedad.</p>
    </div>

    <!-- SECCIÓN DE FIRMA EXCLUSIVA DEL ADMINISTRADOR -->
    <div class="text-center" style="margin-top: 20px;">
        @if (!string.IsNullOrEmpty(Model.FirmaAdminEntregaBase64))
        {
            <img src="@Model.FirmaAdminEntregaBase64" class="admin-signature" alt="Firma Administrador" />
        }
        else
        {
            <div class="signature-box"></div>
        }
        <p style="margin: 2px 0 0 0; font-size: 11px;" class="fw-bold">@nombreAdmin</p>
        <p style="margin: 0; font-size: 10px;">Firma y Autorización del Administrador</p>
    </div>

    <!-- BOTÓN DE VOLVER MUY ABAJO Y OCULTO AL IMPRIMIR -->
    <div class="text-center" style="margin-top: 50px; margin-bottom: 30px;">
        <a href="/Admin/Inicio" style="display: inline-block; padding: 10px 20px; background: #198754; color: white; text-decoration: none; border-radius: 5px; font-family: sans-serif; font-weight: bold;" class="d-print-none">← Volver al Panel</a>
    </div>

</body>
</html>