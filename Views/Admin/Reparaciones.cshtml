@model IEnumerable<MonitoreoWeb.Models.Reparacion>

@{
    ViewData["Title"] = "Reparaciones";
}

<div class="container-fluid">

    <div class="mb-4">

        <h1>
            Reparaciones
        </h1>

        <p class="text-muted">
            Consulta y supervisa el estado de las reparaciones.
        </p>

    </div>

    <!-- ========================================== -->
    <!-- FILTROS -->
    <!-- ========================================== -->

    <form asp-controller="Admin"
          asp-action="Reparaciones"
          method="get"
          class="mb-4">

        <div class="row g-3">

            <!-- BÚSQUEDA -->

            <div class="col-md-6">

                <label class="form-label">
                    Buscar
                </label>

                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Código, cliente, marca o modelo..." />

            </div>


            <!-- ESTADO -->

            <div class="col-md-4">

                <label class="form-label">
                    Estado
                </label>

                <select name="estado"
                        class="form-select">

                    <option value="">
                        Todos los estados
                    </option>

                    <option value="1"
                            selected="@(ViewBag.Estado == 1)">
                        Pendiente
                    </option>

                    <option value="2"
                            selected="@(ViewBag.Estado == 2)">
                        Aceptada
                    </option>

                    <option value="3"
                            selected="@(ViewBag.Estado == 3)">
                        En diagnóstico
                    </option>

                    <option value="4"
                            selected="@(ViewBag.Estado == 4)">
                        Esperando refacción
                    </option>

                    <option value="5"
                            selected="@(ViewBag.Estado == 5)">
                        En reparación
                    </option>

                    <option value="6"
                            selected="@(ViewBag.Estado == 6)">
                        En pruebas
                    </option>

                    <option value="7"
                            selected="@(ViewBag.Estado == 7)">
                        Terminada
                    </option>

                </select>

            </div>


            <!-- BOTONES -->

            <div class="col-md-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary w-100">

                    Buscar

                </button>

            </div>

        </div>


        <div class="mt-3">

            <a asp-controller="Admin"
               asp-action="Reparaciones"
               class="btn btn-outline-secondary">

                Limpiar filtros

            </a>

        </div>

    </form>
    @if (!Model.Any())
    {
        <div class="alert alert-info">

            No se encontraron reparaciones
            con los criterios seleccionados.

        </div>
    }

    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>
                            Código
                        </th>

                        <th>
                            Cliente
                        </th>

                        <th>
                            Dispositivo
                        </th>

                        <th>
                            Técnico
                        </th>

                        <th>
                            Estado
                        </th>

                        <th>
                            Fecha de ingreso
                        </th>

                        <th>
                            Acción
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var reparacion in Model)
                    {
                        <tr>

                            <!-- CÓDIGO -->

                            <td>

                                <strong>
                                    @reparacion.TokenConsulta
                                </strong>

                            </td>


                            <!-- CLIENTE -->

                            <td>

                                @reparacion.Dispositivo?.Cliente?.Nombre
                                @reparacion.Dispositivo?.Cliente?.Apellido

                            </td>


                            <!-- DISPOSITIVO -->

                            <td>

                                <strong>
                                    @reparacion.Dispositivo?.Marca
                                </strong>

                                <br />

                                <small class="text-muted">
                                    @reparacion.Dispositivo?.Modelo
                                </small>

                            </td>


                            <!-- TÉCNICO -->

                            <td>

                                @(reparacion.Tecnico?.Nombre
                                                        ?? "Sin aceptar.")

                    </td>


                            <!-- ESTADO -->

                            <td>

                        @{
                                    string estado = reparacion.IdEstado switch
                                    {
                                        1 => "Pendiente",
                                        2 => "Aceptada",
                                        3 => "En diagnóstico",
                                        4 => "Esperando refacción",
                                        5 => "En reparación",
                                        6 => "En pruebas",
                                        7 => "Terminada",
                                        _ => "Desconocido"
                                    };
                                }

                                <span>
                                    @estado
                                </span>

                            </td>


                            <!-- FECHA -->

                            <td>

                                @(reparacion.FechaIngreso
                                .ToString("dd/MM/yyyy HH:mm"))

                            </td>


                            <!-- ACCIÓN -->

                            <td>

                                <a asp-controller="Admin"
                                   asp-action="DetalleReparacion"
                                   asp-route-id="@reparacion.IdReparacion"
                                   class="btn btn-sm btn-primary">

                                    Ver detalle

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>