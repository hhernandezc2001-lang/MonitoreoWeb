@model MonitoreoWeb.Models.Reparacion

@{
    ViewData["Title"] = "Detalle de reparación";

    string estado = Model.IdEstado switch
    {
        1 => "Pendiente",
        2 => "Aceptada",
        3 => "En diagnóstico",
        4 => "Esperando refacción",
        5 => "En reparación",
        6 => "En pruebas",
        7 => "Terminada",
        _ => "Desconocido"
    };

    decimal costoBase = Model.CostoFinal ?? Model.CostoEstimado ?? 0;
    decimal totalPagado = Model.Pagos?.Sum(p => p.Monto) ?? 0;
    decimal saldoPendiente = costoBase - totalPagado;
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="mb-4">

        <span class="text-muted">
            GESTIÓN DE REPARACIONES
        </span>

        <h1>
            Reparación @Model.TokenConsulta
        </h1>

        <p class="text-muted">
            Detalle y seguimiento de la reparación.
        </p>

    </div>

    @await Html.PartialAsync("_BarraEstado", Model.IdEstado)

    <!-- ========================================== -->
    <!-- ESTADO -->
    <!-- ========================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Estado actual
            </h5>

            <h2>
                @estado
            </h2>

        </div>

    </div>


    <div class="row">

        <!-- ====================================== -->
        <!-- CLIENTE -->
        <!-- ====================================== -->

        <div class="col-md-6 mb-4">

            <div class="card h-100">

                <div class="card-body">

                    <h5 class="card-title mb-4">
                        Cliente
                    </h5>

                    <p>
                        <strong>
                            Nombre:
                        </strong>

                        @Model.Dispositivo?.Cliente?.Nombre
                        @Model.Dispositivo?.Cliente?.Apellido
                    </p>

                    <p>
                        <strong>
                            Teléfono:
                        </strong>

                        @Model.Dispositivo?.Cliente?.Telefono
                    </p>

                    <p>
                        <strong>
                            Correo:
                        </strong>

                        @Model.Dispositivo?.Cliente?.Email
                    </p>

                </div>

            </div>

        </div>


        <!-- ====================================== -->
        <!-- DISPOSITIVO -->
        <!-- ====================================== -->

        <div class="col-md-6 mb-4">

            <div class="card h-100">

                <div class="card-body">

                    <h5 class="card-title mb-4">
                        Dispositivo
                    </h5>

                    <p>
                        <strong>
                            Marca:
                        </strong>

                        @Model.Dispositivo?.Marca
                    </p>

                    <p>
                        <strong>
                            Modelo:
                        </strong>

                        @Model.Dispositivo?.Modelo
                    </p>

                    <p>
                        <strong>
                            IMEI:
                        </strong>

                        @(string.IsNullOrWhiteSpace(
                                                Model.Dispositivo?.IMEI)
                                                ? "No registrado"
                                                : Model.Dispositivo.IMEI)
                    </p>

                    <p>
                        <strong>
                            Color:
                        </strong>

                        @(string.IsNullOrWhiteSpace(
                                                Model.Dispositivo?.Color)
                                                ? "No registrado"
                                                : Model.Dispositivo.Color)

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- INFORMACIÓN DE LA REPARACIÓN -->
    <!-- ========================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title mb-4">
                Información de la reparación
            </h5>

            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>
                            Código:
                        </strong>

                        @Model.TokenConsulta
                    </p>

                    <p>
                        <strong>
                            Fecha de ingreso:
                        </strong>

                        @(Model.FechaIngreso
                                                .ToString("dd/MM/yyyy HH:mm"))
                    </p>

                    <p>
                        <strong>
                            Entrega estimada:
                        </strong>

                        @(Model.FechaEntregaEstimada.HasValue
                                                ? Model.FechaEntregaEstimada.Value
                                                .ToString("dd/MM/yyyy")
                                                : "Sin definir")

                    </p>

                </div>


                <div class="col-md-6">

                    <p>
                        <strong>
                            Técnico asignado:
                        </strong>

                        @(Model.Tecnico?.Nombre
                                                ?? "Sin asignar")
                    </p>

                    <p>
                        <strong>
                            Costo estimado:
                        </strong>

                        @(Model.CostoEstimado.HasValue
                                                ? $"${Model.CostoEstimado:N2}"
                                                : "No definido")
                    </p>

                    <p>
                        <strong>
                            Costo final:
                        </strong>

                        @(Model.CostoFinal.HasValue
                                                ? $"${Model.CostoFinal:N2}"
                                                : "No definido")
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- PAGOS -->
    <!-- ========================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title mb-4">
                Pagos
            </h5>

            @if (Model.Pagos == null || !Model.Pagos.Any())
            {
                <p class="text-muted">
                    Aún no se ha registrado ningún pago para esta reparación.
                </p>
            }
            else
            {
                <table class="table table-sm">

                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Monto</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var pago in Model.Pagos.OrderBy(p => p.FechaPago))
                        {
                            <tr>
                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@($"${pago.Monto:N2}")</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }

            <hr />

            <div class="row">

                <div class="col-md-4">
                    <p>
                        <strong>Costo a cubrir:</strong>
                        @($"${costoBase:N2}")
                        <span class="text-muted">
                            (@(Model.CostoFinal.HasValue ? "costo final" : "costo estimado"))
                        </span>
                    </p>
                </div>

                <div class="col-md-4">
                    <p>
                        <strong>Total pagado:</strong>
                        @($"${totalPagado:N2}")
                    </p>
                </div>

                <div class="col-md-4">
                    <p>
                        <strong>Saldo pendiente:</strong>
                        @($"${saldoPendiente:N2}")
                    </p>
                </div>

            </div>

            @if (saldoPendiente > 0 && Model.Activo)
            {
                <form asp-controller="Admin"
                      asp-action="RegistrarPago"
                      asp-route-id="@Model.IdReparacion"
                      method="post"
                      class="d-flex gap-2 align-items-end mt-3">

                    @Html.AntiForgeryToken()

                    <div>
                        <label class="form-label">
                            Registrar nuevo pago
                        </label>

                        <input type="number"
                               name="monto"
                               step="0.01"
                               min="0.01"
                               max="@saldoPendiente"
                               class="form-control"
                               placeholder="Ej. @saldoPendiente.ToString("0.00")" />
                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Registrar pago
                    </button>

                </form>
            }
            else if (saldoPendiente <= 0)
            {
                <div class="alert alert-success mt-3 mb-0">
                    ✅ Esta reparación ya está completamente pagada.
                </div>
            }

        </div>

    </div>


    <!-- ========================================== -->
    <!-- PROBLEMA -->
    <!-- ========================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Problema reportado
            </h5>

            <p>
                @Model.ProblemaReportado
            </p>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- DIAGNÓSTICO -->
    <!-- ========================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Diagnóstico
            </h5>

            @if (string.IsNullOrWhiteSpace(Model.Diagnostico))
            {
                <p class="text-muted">
                    El técnico todavía no ha registrado un diagnóstico.
                </p>
            }
            else
            {
                <p>
                    @Model.Diagnostico
                </p>
            }

        </div>

    </div>


    <!-- ========================================== -->
    <!-- FECHA DE TERMINACIÓN -->
    <!-- ========================================== -->
    @if (Model.FechaEntregaReal.HasValue)
    {
        <div class="card mb-4">

            <div class="card-body">

                <h5 class="card-title">
                    Terminación
                </h5>

                <p>

                    <strong>
                        Fecha de terminación:
                    </strong>

                    @(Model.FechaEntregaReal.Value
                                    .ToString("dd/MM/yyyy HH:mm"))

            </p>

            </div>

        </div>
        }


    <!-- ========================================== -->
    <!-- BITÁCORA -->
    <!-- ========================================== -->
    @await Html.PartialAsync(
    "_BitacoraAvances",
        (MonitoreoWeb.Models.ViewModels.BitacoraViewModel)ViewBag.Bitacora)

    <!-- ========================================== -->
    <!-- ACCIONES -->
    <!-- ========================================== -->

    <div class="mt-4 d-flex gap-2">

        <a asp-controller="Admin"
           asp-action="Reparaciones"
           class="btn btn-secondary">

            ← Volver a reparaciones

        </a>

        <a asp-controller="Admin"
           asp-action="Ticket"
           asp-route-id="@Model.IdReparacion"
           target="_blank"
           class="btn btn-outline-primary">

            🧾 Ver ticket

        </a>

    </div>

</div>
