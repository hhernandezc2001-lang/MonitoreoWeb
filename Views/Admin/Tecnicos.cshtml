@model IEnumerable<MonitoreoWeb.Models.Usuario>
@{
    ViewData["Title"] = "Técnicos dados de alta";
}
<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Técnicos dados de alta</h2>
            <p class="text-muted mb-0">
                Lista de técnicos activos registrados en el sistema.
            </p>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="row mb-3 g-2">
        <div class="col-md-4">
            <input type="text" id="filtraNombre" class="form-control"
                   placeholder="Buscar por nombre..." />
        </div>
        <div class="col-md-4">
            <input type="date" id="filtraFecha" class="form-control" />
        </div>
        <div class="col-md-4">
            <select id="filtraEstado" class="form-select">
                <option value="">Todos</option>
                <option value="activo">Activo</option>
                <option value="inactivo">Inactivo</option>
            </select>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Fecha de creación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tecnico in Model)
                    {
                        <tr>
                            <td>@tecnico.IdUsuario</td>
                            <td>@tecnico.Nombre</td>
                            <td>@tecnico.Email</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @tecnico.Rol
                                </span>
                            </td>
                            <td>
                                @if (tecnico.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>@tecnico.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No hay técnicos activos registrados.
        </div>
    }
</div>

@section Scripts {
    <script>
        function aplicarFiltros() {
            const nombre = document.getElementById('filtraNombre').value.toLowerCase();
            const fecha = document.getElementById('filtraFecha').value;
            const estado = document.getElementById('filtraEstado').value.toLowerCase();
            const filas = document.querySelectorAll('tbody tr');

            filas.forEach(fila => {
                const tdNombre = fila.cells[1].textContent.toLowerCase();
                const tdFecha  = fila.cells[5].textContent.trim();
                const tdEstado = fila.cells[4].textContent.toLowerCase().trim();

                // Convertir fecha de tabla (dd/MM/yyyy) a yyyy-MM-dd para comparar
                let fechaCoincide = true;
                if (fecha) {
                    const partes = tdFecha.split('/');
                    const fechaFila = `${partes[2]}-${partes[1]}-${partes[0]}`;
                    fechaCoincide = fechaFila === fecha;
                }

                const nombreCoincide = tdNombre.includes(nombre);
                const estadoCoincide = estado === '' || tdEstado.includes(estado);

                fila.style.display = (nombreCoincide && fechaCoincide && estadoCoincide) ? '' : 'none';
            });
        }

        document.getElementById('filtraNombre').addEventListener('keyup', aplicarFiltros);
        document.getElementById('filtraFecha').addEventListener('change', aplicarFiltros);
        document.getElementById('filtraEstado').addEventListener('change', aplicarFiltros);
    </script>
}