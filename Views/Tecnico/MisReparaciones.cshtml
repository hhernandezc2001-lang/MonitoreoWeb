@model IEnumerable<MonitoreoWeb.Models.Reparacion>

@{
    var reparaciones = Model.ToList();

    string TextoEstado(int idEstado) => idEstado switch
    {
        2 => "Aceptada",
        3 => "En diagnóstico",
        4 => "Esperando refacción",
        5 => "En reparación",
        6 => "En pruebas",
        7 => "Terminada",
        _ => "Estado desconocido"
    };
}

<div class="tecnico-solicitudes-page">

    <div class="tecnico-solicitudes-header">

        <div>

            <span class="tecnico-subtitulo">
                PANEL DEL TÉCNICO
            </span>

            <h1>
                Mis reparaciones
            </h1>

            <p>
                Consulta las reparaciones que tienes asignadas.
            </p>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- PESTAÑAS -->
    <!-- ========================================== -->

    <div class="solicitudes-tabs">

        <a asp-controller="Tecnico"
           asp-action="MisReparaciones"
           asp-route-vista="curso"
           class="solicitudes-tab @(ViewBag.Vista == "curso" ? "activa" : "")">
            En curso
            <span class="tab-contador">@ViewBag.EnCursoCount</span>
        </a>

        <a asp-controller="Tecnico"
           asp-action="MisReparaciones"
           asp-route-vista="finalizadas"
           class="solicitudes-tab @(ViewBag.Vista == "finalizadas" ? "activa" : "")">
            Finalizadas
            <span class="tab-contador">@ViewBag.FinalizadasCount</span>
        </a>

    </div>


    <!-- ========================================== -->
    <!-- LISTADO -->
    <!-- ========================================== -->
    @if (!reparaciones.Any())
    {
        <div class="tecnico-solicitudes-vacio">

            <div class="tecnico-vacio-icono">
                ✓
            </div>

            <h2>
                @(ViewBag.Vista == "finalizadas"
                            ? "Aún no tienes reparaciones finalizadas"
                            : "No tienes reparaciones en curso")
                                                            </h2>

            <p>
                @(ViewBag.Vista == "finalizadas"
                            ? "Las reparaciones que completes aparecerán aquí."
                            : "Actualmente no tienes reparaciones activas para trabajar.")
        </p>

        </div>
        }
    else
    {
        <div class="tecnico-solicitudes-grid">

            @foreach (var reparacion in reparaciones)
            {
                <article class="tecnico-solicitud-card">

                    <div class="tecnico-card-header">

                        <div>

                            <span class="tecnico-solicitud-id">
                                REPARACIÓN #@reparacion.IdReparacion
                            </span>

                            <h2>
                                @reparacion.Dispositivo?.Marca
                                @reparacion.Dispositivo?.Modelo
                            </h2>

                        </div>

                        <span class="tecnico-estado @(reparacion.IdEstado == 7 ? "tecnico-estado-terminada" : "")">
                            @TextoEstado(reparacion.IdEstado)
                        </span>

                    </div>


                    <!-- ================================= -->
                    <!-- DISPOSITIVO -->
                    <!-- ================================= -->

                    <div class="tecnico-card-seccion">

                        <span class="tecnico-seccion-titulo">
                            DISPOSITIVO
                        </span>

                        <div class="tecnico-datos">

                            <div>

                                <span>
                                    Marca
                                </span>

                                <strong>
                                    @reparacion.Dispositivo?.Marca
                                </strong>

                            </div>

                            <div>

                                <span>
                                    Modelo
                                </span>

                                <strong>
                                    @reparacion.Dispositivo?.Modelo
                                </strong>

                            </div>

                            <div>

                                <span>
                                    IMEI
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(
                                                                reparacion.Dispositivo?.IMEI)
                                                                ? "No registrado"
                                                                : reparacion.Dispositivo.IMEI)
                                                                                          </strong>

                            </div>

                            <div>

                                <span>
                                    Color
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(
                                                                reparacion.Dispositivo?.Color)
                                                                ? "No registrado"
                                                                : reparacion.Dispositivo.Color)
                                                                                           </strong>

                            </div>

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- CLIENTE -->
                    <!-- ================================= -->

                    <div class="tecnico-card-seccion">

                        <span class="tecnico-seccion-titulo">
                            CLIENTE
                        </span>

                        <div class="tecnico-cliente">

                            <div class="tecnico-avatar">

                                @(reparacion.Dispositivo?.Cliente?.Nombre?
                                                        .Substring(0, 1)
                                                        .ToUpper() ?? "?")

                            </div>

                            <div>

                                <strong>

                                    @reparacion.Dispositivo?.Cliente?.Nombre
                                    @reparacion.Dispositivo?.Cliente?.Apellido

                                </strong>

                                <span>
                                    📞
                                    @reparacion.Dispositivo?.Cliente?.Telefono
                                </span>

                                <span>
                                    ✉
                                    @reparacion.Dispositivo?.Cliente?.Email
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- PROBLEMA -->
                    <!-- ================================= -->

                    <div class="tecnico-card-seccion">

                        <span class="tecnico-seccion-titulo">
                            PROBLEMA REPORTADO
                        </span>

                        <div class="tecnico-problema">

                            @reparacion.ProblemaReportado

                        </div>

                    </div>


                    <!-- ================================= -->
                    <!-- FECHAS -->
                    <!-- ================================= -->

                    <div class="tecnico-card-fechas">

                        <div>

                            <span>
                                Fecha de ingreso
                            </span>

                            <strong>
                                @(reparacion.FechaIngreso.ToString("dd/MM/yyyy HH:mm"))
                            </strong>

                        </div>

                        <div>

                            <span>
                                Entrega estimada
                            </span>

                            <strong>

                                @(reparacion.FechaEntregaEstimada.HasValue
                                                        ? reparacion.FechaEntregaEstimada.Value
                                                        .ToString("dd/MM/yyyy")
                                                        : "Sin definir")

                    </strong>

                        </div>

                    </div>

                    <!-- ================================= -->
                    <!-- ACCIÓN -->
                    <!-- ================================= -->

                    <div class="tecnico-card-footer">

                        <a asp-controller="Tecnico"
                           asp-action="Detalle"
                           asp-route-id="@reparacion.IdReparacion"
                           class="btn-aceptar-reparacion">

                            Ver reparación

                        </a>

                    </div>

                </article>
                }

        </div>
    }

</div>