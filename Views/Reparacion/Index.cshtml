@model IEnumerable<MonitoreoWeb.Models.ViewModels.SolicitudReparacionViewModel>

@{
    var solicitudes = Model.ToList();
}

<div class="solicitudes-page">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="solicitudes-header">

        <div>

            <span class="solicitudes-subtitulo">
                GESTIÓN DE REPARACIONES
            </span>

            <h1>
                Solicitudes pendientes de aceptar
            </h1>

            <p>
                Reparaciones que aún no han sido tomadas
                por ningún técnico.
            </p>

        </div>
    </div>


    <!-- ========================================== -->
    <!-- CONTADOR -->
    <!-- ========================================== -->

    <div class="solicitudes-contador">

        <span class="contador-icono">
            ⏳
        </span>

        <span>
            @solicitudes.Count
            @(solicitudes.Count == 1
                        ? "solicitud esperando técnico"
                        : "solicitudes esperando técnico")
        </span>

    </div>


    <!-- ========================================== -->
    <!-- LISTADO -->
    <!-- ========================================== -->

    <div class="solicitudes-contenido">


        @if (!solicitudes.Any())
        {

            <!-- ====================================== -->
            <!-- SIN SOLICITUDES -->
            <!-- ====================================== -->

            <div class="solicitudes-vacio">

                <div class="vacio-icono">
                    ✓
                </div>

                <h2>
                    No hay solicitudes pendientes
                </h2>

                <p>
                    Todas las solicitudes registradas ya fueron
                    tomadas por un técnico.
                </p>

            </div>

        }
        else
        {

            <!-- ====================================== -->
            <!-- SOLICITUDES -->
            <!-- ====================================== -->

            <div class="solicitudes-grid">

                @foreach (var solicitud in solicitudes)
                {

                    <article class="solicitud-card">


                        <!-- ================================= -->
                        <!-- CABECERA -->
                        <!-- ================================= -->

                        <div class="solicitud-card-header">

                            <div>

                                <span class="solicitud-numero">
                                    SOLICITUD #@solicitud.IdReparacion
                                </span>

                                <h2>
                                    @solicitud.Marca
                                    @solicitud.Modelo
                                </h2>

                            </div>


                            <span class="estado-pendiente">
                                Pendiente
                            </span>

                        </div>


                        <!-- ================================= -->
                        <!-- INFORMACIÓN DEL DISPOSITIVO -->
                        <!-- ================================= -->

                        <div class="solicitud-seccion">

                            <div class="seccion-titulo">
                                DISPOSITIVO
                            </div>


                            <div class="solicitud-datos-grid">


                                <div class="solicitud-dato">

                                    <span>
                                        Marca
                                    </span>

                                    <strong>
                                        @solicitud.Marca
                                    </strong>

                                </div>


                                <div class="solicitud-dato">

                                    <span>
                                        Modelo
                                    </span>

                                    <strong>
                                        @solicitud.Modelo
                                    </strong>

                                </div>


                                <div class="solicitud-dato">

                                    <span>
                                        IMEI
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(solicitud.IMEI)
                                                                        ? "No registrado"
                                                                        : solicitud.IMEI)
                                                                                     </strong>

                                </div>


                                <div class="solicitud-dato">

                                    <span>
                                        Color
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(solicitud.Color)
                                                                        ? "No registrado"
                                                                        : solicitud.Color)
                                                                                      </strong>

                                </div>


                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- CLIENTE -->
                        <!-- ================================= -->

                        <div class="solicitud-seccion">

                            <div class="seccion-titulo">
                                CLIENTE
                            </div>


                            <div class="cliente-solicitud">

                                <div class="cliente-avatar">
                                    @solicitud.NombreCliente.Substring(0, 1).ToUpper()
                                </div>


                                <div class="cliente-info">

                                    <strong>

                                        @solicitud.NombreCliente
                                        @solicitud.ApellidoCliente

                                    </strong>


                                    <span>
                                        📞 @solicitud.TelefonoCliente
                                    </span>


                                    <span>
                                        ✉ @solicitud.EmailCliente
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- PROBLEMA -->
                        <!-- ================================= -->

                        <div class="solicitud-seccion">

                            <div class="seccion-titulo">
                                PROBLEMA REPORTADO
                            </div>


                            <div class="problema-reportado">

                                @solicitud.ProblemaReportado

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- FECHAS -->
                        <!-- ================================= -->

                        <div class="solicitud-fechas">

                            <div>

                                <span>
                                    Fecha de ingreso
                                </span>

                                <strong>
                                    @solicitud.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Entrega estimada
                                </span>

                                <strong>

                                    @(solicitud.FechaEntregaEstimada.HasValue
                                                                ? solicitud.FechaEntregaEstimada.Value.ToString("dd/MM/yyyy")
                                                                : "Sin definir")

                        </strong>

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- TÉCNICO -->
                        <!-- ================================= -->

                        <div class="solicitud-tecnico">

                            <span class="seccion-titulo">
                                TÉCNICO
                            </span>

                            <div class="tecnico-info">

                                <span class="badge-pendiente-aceptacion">
                                    Pendiente de aceptación
                                </span>

                            </div>

                        </div>


                    </article>

                        }

            </div>

        }

    </div>

</div>