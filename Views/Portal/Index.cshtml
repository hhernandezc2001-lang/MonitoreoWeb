@{
    ViewData["Title"] = "Portal";
}

<div class="container py-5">

    <!-- Encabezado -->
    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold">
            Sistema de Gestión y Monitoreo de Reparaciones
        </h1>

        <p class="lead text-muted mt-3">
            Consulte el estado de su reparación o comuníquese con nuestro asistente virtual.
        </p>

    </div>

    <!-- Tarjetas -->
    <div class="row g-4">

        <!-- Consultar reparación -->
        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h3 class="card-title">
                        Consultar reparación
                    </h3>

                    <p class="text-muted">
                        Ingrese el token proporcionado al momento de registrar su equipo.
                    </p>

                    <input type="text"
                           class="form-control mb-3"
                           placeholder="Ingrese su token">

                    <button class="btn btn-primary w-100">
                        Consultar
                    </button>

                </div>

            </div>

        </div>

        <!-- Chatbot -->
        <div class="col-md-6">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h3 class="card-title">
                         Asistente Virtual
                    </h3>

                    <p class="text-muted">
                        Resuelva dudas sobre el proceso de reparación, tiempos de entrega y uso del sistema.
                    </p>

                    <button class="btn btn-success w-100">
                        Abrir Chat
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Información -->
    <div class="card shadow mt-5">

        <div class="card-body">

            <h3 class="mb-4">
                 Información
            </h3>

            <div class="row">

                <div class="col-md-4">

                    <h5>Horario</h5>

                    <p class="text-muted">
                        Lunes a Viernes<br>
                        9:00 AM - 6:00 PM
                    </p>

                </div>

                <div class="col-md-4">

                    <h5>Contacto</h5>

                    <p class="text-muted">
                        blabla@empresa.com<br>
                        (55) 3978-3607
                    </p>

                </div>

                <div class="col-md-4">

                    <h5>Acerca del sistema</h5>

                    <p class="text-muted">
                        Plataforma para el monitoreo del estado de reparaciones de dispositivos móviles.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>